# ---- Datasets: never commit data files, only the READMEs + .gitkeep --------------
# (structural real/synthetic separation per ADR-0010)
data/real/*
data/synthetic/*
!data/real/README.md
!data/real/.gitkeep
!data/synthetic/README.md
!data/synthetic/.gitkeep

