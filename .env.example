# ==============================================================================
# IntelliCredit — environment template. Copy to `.env` at the repo root:
#   cp .env.example .env
#
# Two consumption paths:
#   1. HOST-LOCAL dev (backend runs on your machine, services in docker):
#      the values below already point at 127.0.0.1 published ports.
#   2. DOCKER COMPOSE (everything in containers): compose loads this file via
#      env_file AND overrides the connection URLs (IC_DATABASE__URL,
#      IC_REDIS__URL, IC_CELERY__*) with in-network service hostnames
#      (postgres/redis) — see the x-backend-env anchor in docker-compose.yml.
#
# Settings are nested pydantic-settings: prefix IC_, nested delimiter "__".
# ==============================================================================

# ---- docker compose: postgres bootstrap (postgres service only) --------------
POSTGRES_USER=intellicredit
POSTGRES_PASSWORD=intellicredit
POSTGRES_DB=intellicredit

# ---- app ----------------------------------------------------------------------
# env: development | testing | production
IC_APP__ENV=development
IC_APP__DEBUG=true
IC_APP__NAME=IntelliCredit
IC_APP__API_PREFIX=/api/v1
# JSON list — origins allowed by CORS (the Next.js dev/prod frontend).
IC_APP__CORS_ORIGINS=["http://localhost:3000"]
# Reported by /health and the OpenAPI spec; defaults to the packaged version.
#IC_APP__VERSION=0.2.0

# ---- database (async SQLAlchemy DSN) -------------------------------------------
# host-local : postgresql+asyncpg://intellicredit:intellicredit@127.0.0.1:5432/intellicredit
# compose    : postgresql+asyncpg://intellicredit:intellicredit@postgres:5432/intellicredit
#              (set automatically by docker-compose.yml — do not change here)
IC_DATABASE__URL=postgresql+asyncpg://intellicredit:intellicredit@127.0.0.1:5432/intellicredit
# Non-superuser application role bound by row-level security (ADR-0013).
# Created idempotently by `make seed` (app.infrastructure.db.rls); tenant
# sessions refuse to run without it. Compose overrides host to `postgres`.
IC_DATABASE__RLS_URL=postgresql+asyncpg://intellicredit_app:intellicredit_app@127.0.0.1:5432/intellicredit
IC_DATABASE__ECHO=false
IC_DATABASE__POOL_SIZE=10
IC_DATABASE__MAX_OVERFLOW=20

# ---- redis ---------------------------------------------------------------------
# host-local : redis://127.0.0.1:6379/0    compose: redis://redis:6379/0 (automatic)
IC_REDIS__URL=redis://127.0.0.1:6379/0

# ---- auth ----------------------------------------------------------------------
# Minimum 16 characters. NEVER ship the placeholder to production.
IC_AUTH__JWT_SECRET=change-me-dev-secret-16+
IC_AUTH__JWT_ALGORITHM=HS256
IC_AUTH__ACCESS_TTL_SECONDS=900
IC_AUTH__REFRESH_TTL_SECONDS=1209600

# ---- celery --------------------------------------------------------------------
# host-local : redis://127.0.0.1:6379/1|2  compose: redis://redis:6379/1|2 (automatic)
IC_CELERY__BROKER_URL=redis://127.0.0.1:6379/1
IC_CELERY__RESULT_BACKEND=redis://127.0.0.1:6379/2
IC_CELERY__DEFAULT_QUEUE=agents
# JSON list — queues the worker consumes (matches compose worker -Q flag).
#IC_CELERY__QUEUES=["agents","ingest","ocr"]

# ---- logging -------------------------------------------------------------------
IC_LOG__LEVEL=INFO
# true = JSON lines (production-shaped); false = pretty console renderer.
IC_LOG__JSON=true

# ---- frontend ------------------------------------------------------------------
# Inlined into the browser bundle at build time (NEXT_PUBLIC_*): the URL the
# BROWSER uses to reach the API — localhost even under docker compose.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- ops profile (docker compose --profile ops up -d) ---------------------------
PGADMIN_DEFAULT_EMAIL=admin@intellicredit.local
PGADMIN_DEFAULT_PASSWORD=change-me

# --- Blob storage (ADR-0016) --------------------------------------------------
# Local filesystem root for originals + derived artifacts. Compose overrides
# this to the shared appstorage volume (/srv/storage).
IC_STORAGE__ROOT=./storage

# --- Gemini (ADR-0005; OPTIONAL) ----------------------------------------------
# Without a key, LLM-dependent pipeline steps (classification tier-2, vision
# OCR escalation, narrative-statement extraction) park with a machine-readable
# `gemini_unconfigured` error; everything deterministic keeps working. The key
# is also accepted via the plain fallbacks GEMINI_API_KEY / GOOGLE_API_KEY /
# GEMINI_API (in that precedence, after IC_GEMINI__API_KEY). SECRET — never
# commit a real value; it never reaches logs/traces/frontend.
# IC_GEMINI__API_KEY=your-key-here
#IC_GEMINI__FLASH_MODEL=gemini-3.7-flash
#IC_GEMINI__PRO_MODEL=gemini-3.1-pro-preview

# --- Tavily web research (OPTIONAL) -------------------------------------------
# Without a key the research agent degrades honestly (configured=false, neutral
# severity, no fabricated sources). SECRET. Sent only to Tavily's API body.
# IC_TAVILY__API_KEY=your-tavily-key
#IC_TAVILY__BASE_URL=https://api.tavily.com
#IC_TAVILY__TIMEOUT_SECONDS=20.0

# --- Agent / LLM gateway (ADR-0005) -------------------------------------------
# llm_mode: live | record | replay. `replay` serves only recorded responses
# (offline demo / CI); `record` is live + persists fixtures. run_cost_cap_usd is
# the hard per-run USD circuit breaker; llm_max_retries covers transient 5xx/429.
#IC_AGENT__LLM_MODE=live
#IC_AGENT__RUN_COST_CAP_USD=2.0
#IC_AGENT__RATE_LIMIT_PER_SEC=8.0
#IC_AGENT__LLM_MAX_RETRIES=3

# --- ML PD model (ADR-0010) ---------------------------------------------------
# artifact_dir holds the champion model; compose points it at the shared volume
# (/srv/storage/models). Disable to run without the ml_default_risk pillar.
#IC_ML__ENABLED=true
#IC_ML__ARTIFACT_DIR=./storage/models
#IC_ML__CHAMPION_MODEL_NAME=pd_model
#IC_ML__MIN_FEATURE_COVERAGE=0.6

# --- Ingestion guardrails (§15.2) ---------------------------------------------
#IC_INGEST__MAX_UPLOAD_MB=50
#IC_INGEST__ZIP_MAX_DEPTH=3
#IC_INGEST__ZIP_MAX_TOTAL_MB=200
#IC_INGEST__PAGE_RENDER_DPI=220
